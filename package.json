{
  "name": "dsh-usage-balance-card",
  "version": "1.15.8",
  "type": "module",
  "description": "DeepSeek Harness usage statistics: workspace, model, and channel token/cost accounting, per-turn ledger, price catalog, and CSV/Excel export.",
  "license": "MIT",
  "author": "H-ATK",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/H-ATK/dsh-usage.git"
  },
  "homepage": "https://github.com/H-ATK/dsh-usage#readme",
  "bugs": {
    "url": "https://github.com/H-ATK/dsh-usage/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "usage",
    "balance",
    "token",
    "cost"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.3"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "pricing.json",
    "locale/*.json",
    "icon.svg",
    "docs",
    "README.md",
    "INSTALL.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-trajectory",
        "@deepseek-ai/dsh-client-ui-settings-account"
      ]
    }
  }
}
